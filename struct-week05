    int vtmin = 0;

    for (int i = 1; i < n; i++)
    {
        if (x[i].price > x[vtmax].price)
        {
            vtmax = i;
        }
        if (x[i].price < x[vtmin].price)
        {
            vtmin = i;
        }
    }


// Câu 4
    string type;
    int dem;
    cout << "Nhap type can dem: ";
    cin >> type;
    dem = 0;
    for (int i = 0; i < n; i++)
    {
        if (x[i].type == type)
        {
            dem++;
        }
    }
    cout << type << " : " << dem << endl;

// Câu 5
    string ten;
    bool found = false;
    cout << "\nEnter flower name to search: ";
    cin >> ten;

    for (int i = 0; i < n; i++)
    {
        if (x[i].name == ten)
        {
            cout << "\nFound!" << endl;
            cout << "Name: " << x[i].name << endl;
            cout << "Price: " << x[i].price << endl;
            cout << "Quantity: " << x[i].quantity << endl;
            cout << "Type: " << x[i].type << endl;
            found = true;
            break;
        }
    }

    if (found == false)
    {
        cout << "khong thay" << endl;
    }

// Câu 6
    int tongquantity = 0;
    double tongprice = 0;

    for (int i = 0; i < n; i++)
    {
        tongquantity += x[i].quantity;
        tongprice += x[i].price;
    }

    double averageprice = tongprice / n;
    cout << "Total flowers: " << n << endl;
    cout << "Total quantity: " << tongquantity << endl;
    cout << "Average price: " << averageprice << endl;


//cau 1.2
    for (int i = 0; i < n; i++)
    {
        cout << i + 1 << ". "
             << x[i].name << " - "
             << x[i].price << " - "
             << x[i].quantity << " - "
             << x[i].type << endl;
    }

//cau 2.2
int vtMax = 0;

    for (int i = 1; i < n; i++)
    {
        if (x[i].price > x[vtMax].price)
        {
            vtMax = i;
        }
    }
    cout << "flower: " << x[vtMax].name << endl;
    cout << "price: " << x[vtMax].price << endl;

//cau 3.2
    int vtMin = 0;

    for (int i = 1; i < n; i++)
    {
        if (x[i].price < x[vtMin].price)
        {
            vtMin = i;
        }
    }
    cout << "flower: " << x[vtMin].name << endl;
    cout << "price: " << x[vtMin].price << endl;


//cau 4.2
    int vtQuantity = 0;

    for (int i = 1; i < n; i++)
    {
        if (x[i].quantity > x[vtQuantity].quantity)
        {
            vtQuantity = i;
        }
    }
    cout << "flower: " << x[vtQuantity].name << endl;
    cout << "quantity: " << x[vtQuantity].quantity << endl;

//cau 5.2
int tongQuantity = 0;

    for (int i = 0; i < n; i++)
    {
