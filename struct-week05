        while (x[i].price <= 0)
        {
            cout << "price phai > 0, nhap lai: ";
            cin >> x[i].price;
        }

        cout << "quantity: ";
        cin >> x[i].quantity;

        while (x[i].quantity < 0)
        {
            cout << "quantity phai >= 0, nhap lai: ";
            cin >> x[i].quantity;
        }

        cout << "type: ";
        cin >> x[i].type;
    }


 // Câu 2
    for (int i = 0; i < n; i++)
    {
        cout << i + 1 << " "
             << x[i].name << " "
